# Copy to apps/api/.env — these defaults match docker-compose.yml
DATABASE_URL=postgresql://hub:hub@localhost:5433/delivery_hub
REDIS_URL=redis://localhost:6379
PORT=3000
# Origin allowed to open cross-origin websocket connections (the Vite dev
# proxy is same-origin, so this only matters when serving web elsewhere)
DASHBOARD_ORIGIN=http://localhost:5173

# Simulated provider webhook secrets (any value works locally; the simulator signs with these)
RAPPI_WEBHOOK_SECRET=local-rappi-secret
UBEREATS_WEBHOOK_SECRET=local-ubereats-secret
DIDI_WEBHOOK_SECRET=local-didi-secret
