{
  "name": "@delivery-hub/api",
  "version": "0.1.0",
  "private": true,
  "description": "Ingestion API and async worker for the delivery orders hub",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
